NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL="postgresql://netroku:netroku@localhost:5432/netroku?schema=public"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# 32-byte hex key for encrypted fields. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Comma-separated origins allowed by Better Auth (LAN IPs, Tailscale, ts.net host)
TRUSTED_ORIGINS=http://localhost:3000
# Set to "true" only when served exclusively over HTTPS. Leave unset for HTTP/LAN access.
SECURE_COOKIES=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Bearer token the external scheduler must send (Authorization: Bearer <token>)
# to call POST /api/cron/resync. Generate with: openssl rand -hex 32
SCHEDULER_TOKEN=
# Bearer token accepted by POST /api/ingest/legacy/*.
# Generate with: openssl rand -hex 32
LEGACY_INGEST_TOKEN=

# Inventory automatic refresh requires SCHEDULER_TOKEN and a running scheduler
# calling POST /api/cron/tick, even for Legacy-only installations.
# Worker heartbeat window (seconds), minimum 1200; increase for slower tick intervals.
INVENTORY_WORKER_STALE_AFTER_SECONDS=1200
# Completed reconciliation jobs retained for this many days (1-365).
INVENTORY_JOB_RETENTION_DAYS=7
